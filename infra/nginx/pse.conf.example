# Copiar al directorio conf.d montado por nginx solo después de emitir el certificado.
server {
    listen 80;
    server_name pse.veraapp.tech;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name pse.veraapp.tech;
    ssl_certificate /etc/letsencrypt/live/pse.veraapp.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pse.veraapp.tech/privkey.pem;
    location / {
        resolver 127.0.0.11 valid=10s;
        set $pse http://custodio-simulado:8090;
        proxy_pass $pse;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
